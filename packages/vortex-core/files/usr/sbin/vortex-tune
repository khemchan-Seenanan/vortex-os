#!/bin/bash
# vortex-tune — Vortex OS adaptive memory tuner.
#
# Reads MemTotal and generates the zram, sysctl, cgroup-slice and Node.js heap
# configuration for this machine's RAM tier. Runs as a oneshot before
# zramswap.service and openclaw.service on every boot (RAM can change in VMs).
#
# Sizing table (see ARCHITECTURE.md — changing it requires sign-off):
#   Total RAM   zram   swappiness  MemoryHigh  MemoryMax  node heap
#   <= 2 GB     60%    180         55%         65%        768 MB
#   2-4 GB      50%    180         55%         70%        1536 MB
#   4-8 GB      40%    160         60%         75%        3072 MB
#   >  8 GB     25%    100         65%         80%        4096 MB
#
# Any generated file containing the line "# vortex-tune: manual" is left
# untouched forever (user takes ownership).
set -euo pipefail

TEMPLATES=/usr/share/vortex/templates
ZRAM_CONF=/etc/default/zramswap
SYSCTL_CONF=/etc/sysctl.d/99-vortex-memory.conf
SLICE_DIR=/etc/systemd/system/vortex.slice.d
SLICE_CONF=$SLICE_DIR/50-tuned.conf
ENV_DIR=/etc/vortex
ENV_FILE=$ENV_DIR/openclaw.env
SENTINEL="# vortex-tune: manual"
DEFAULT_GATEWAY_PORT=18789

mem_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
mem_mb=$(( mem_kb / 1024 ))

if   [ "$mem_mb" -le 2048 ]; then
    TIER="<=2GB";  ZRAM_PCT=60; SWAPPINESS=180; MEM_HIGH=55; MEM_MAX=65; NODE_HEAP=768
elif [ "$mem_mb" -le 4096 ]; then
    TIER="2-4GB";  ZRAM_PCT=50; SWAPPINESS=180; MEM_HIGH=55; MEM_MAX=70; NODE_HEAP=1536
elif [ "$mem_mb" -le 8192 ]; then
    TIER="4-8GB";  ZRAM_PCT=40; SWAPPINESS=160; MEM_HIGH=60; MEM_MAX=75; NODE_HEAP=3072
else
    TIER=">8GB";   ZRAM_PCT=25; SWAPPINESS=100; MEM_HIGH=65; MEM_MAX=80; NODE_HEAP=4096
fi

show() {
    cat <<EOF
vortex-tune profile
  MemTotal     : ${mem_mb} MB (tier ${TIER})
  zram size    : ${ZRAM_PCT}% of RAM (zstd)
  swappiness   : ${SWAPPINESS}
  MemoryHigh   : ${MEM_HIGH}%   (vortex.slice)
  MemoryMax    : ${MEM_MAX}%   (vortex.slice)
  node heap    : ${NODE_HEAP} MB (--max-old-space-size)
EOF
}

json() {
    printf '{"mem_total_mb":%d,"tier":"%s","zram_percent":%d,"swappiness":%d,"memory_high_pct":%d,"memory_max_pct":%d,"node_heap_mb":%d}\n' \
        "$mem_mb" "$TIER" "$ZRAM_PCT" "$SWAPPINESS" "$MEM_HIGH" "$MEM_MAX" "$NODE_HEAP"
}

case "${1:-apply}" in
    --show) show; exit 0 ;;
    --json) json; exit 0 ;;
    apply)  ;;
    *) echo "usage: vortex-tune [--show|--json]" >&2; exit 2 ;;
esac

is_manual() { [ -f "$1" ] && grep -qF "$SENTINEL" "$1"; }

# write_if_changed <target> <content>; echoes "changed" when it rewrote the file
write_if_changed() {
    local target=$1 content=$2
    if is_manual "$target"; then
        echo "vortex-tune: $target is user-managed ($SENTINEL), skipping" >&2
        return 0
    fi
    if [ ! -f "$target" ] || [ "$content" != "$(cat "$target")" ]; then
        mkdir -p "$(dirname "$target")"
        printf '%s\n' "$content" > "$target"
        echo changed
    fi
}

render() { sed -e "s/@ZRAM_PCT@/$ZRAM_PCT/g" \
               -e "s/@SWAPPINESS@/$SWAPPINESS/g" \
               -e "s/@TIER@/$TIER/g" "$1"; }

changed=""
changed+=$(write_if_changed "$ZRAM_CONF"   "$(render "$TEMPLATES/zramswap.template")")
changed+=$(write_if_changed "$SYSCTL_CONF" "$(render "$TEMPLATES/sysctl-memory.template")")

slice_content="# Generated by vortex-tune for tier ${TIER}. Do not edit; add '${SENTINEL}' to take ownership.
[Slice]
MemoryHigh=${MEM_HIGH}%
MemoryMax=${MEM_MAX}%"
changed+=$(write_if_changed "$SLICE_CONF" "$slice_content")

# Preserve a user-customized gateway port across regenerations.
port=$DEFAULT_GATEWAY_PORT
if [ -f "$ENV_FILE" ]; then
    existing_port=$(sed -n 's/^OPENCLAW_GATEWAY_PORT=//p' "$ENV_FILE" | head -n1)
    [ -n "$existing_port" ] && port=$existing_port
fi
env_content="# Generated by vortex-tune for tier ${TIER}. Do not edit; add '${SENTINEL}' to take ownership.
NODE_OPTIONS=--max-old-space-size=${NODE_HEAP}
OPENCLAW_GATEWAY_PORT=${port}"
changed+=$(write_if_changed "$ENV_FILE" "$env_content")

# Apply live only under a running systemd (never inside image-build chroots).
if [ -d /run/systemd/system ] && [ -n "$changed" ]; then
    sysctl -q --load="$SYSCTL_CONF" || true
    systemctl daemon-reload
    if systemctl is-active --quiet zramswap.service; then
        systemctl restart zramswap.service || true
    fi
fi

show
