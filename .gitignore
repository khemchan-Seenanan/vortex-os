# Build outputs
dist/
*.deb
*.buildinfo
*.changes
*.img
*.img.xz
*.iso
*.qcow2
*.ova
*.vmdk

# Secrets / local keys — NEVER commit private keys.
repo/keys/dev/
repo/keys/*secret*
repo/keys/*.key
*.asc.secret

# aptly working state
repo/.aptly/
repo/public/

# pi-gen checkout (cloned by targets/pi/build.sh)
targets/pi/pi-gen/

# live-build working dirs
targets/iso/cache/
targets/iso/chroot/
targets/iso/binary/
targets/iso/.build/
targets/iso/config/

# debos scratch
targets/vm/scratch/

# Go
tools/stats-daemon/vortex-stats
tools/stats-daemon/vortex-stats-*

# npm staging for vortex-openclaw (build-time only)
packages/vortex-openclaw/opt/
packages/vortex-openclaw/staging/
packages/*/debian/changelog
packages/*/debian/copyright
!packages/vortex-archive-keyring/debian/copyright
packages/*/debian/*.debhelper*
packages/*/debian/.debhelper/
packages/*/debian/files
packages/*/debian/*.substvars
packages/*/debian/debhelper-build-stamp
packages/*/debian/vortex-*/
packages/vortex-webui/vortex-stats-bin

# misc
*.log
.DS_Store
