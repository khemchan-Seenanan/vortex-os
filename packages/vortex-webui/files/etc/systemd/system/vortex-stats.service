[Unit]
Description=Vortex stats API and first-boot wizard backend
Documentation=https://github.com/khemchan-Seenanan/vortex-os
After=network.target

[Service]
ExecStart=/usr/bin/vortex-stats
DynamicUser=yes
SupplementaryGroups=vortex-setup
Restart=always
RestartSec=3
MemoryMax=32M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=-/run/vortex-setup

[Install]
WantedBy=multi-user.target
