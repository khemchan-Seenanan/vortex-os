#!/bin/sh
# live-build configuration for the Vortex OS amd64 installer ISO.
#
# Decision: --debian-installer live (not cdrom/netinst). The live squashfs is
# built WITH all Vortex packages preinstalled from the signed repo tree bundled
# into the chroot, and d-i's live-installer copies that filesystem to disk —
# a fully offline install that exercises the exact same packages as every
# other target. Rationale + tradeoffs in ARCHITECTURE.md.
set -e

lb config noauto \
    --distribution bookworm \
    --architectures amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --binary-images iso-hybrid \
    --debian-installer live \
    --debian-installer-gui false \
    --linux-flavours amd64 \
    --apt-recommends false \
    --firmware-chroot true \
    --firmware-binary true \
    --memtest none \
    --iso-application "Vortex OS" \
    --iso-publisher "Vortex OS - https://github.com/khemchan-Seenanan/vortex-os" \
    --iso-volume "VORTEX" \
    --bootappend-live "boot=live components quiet" \
    --bootappend-install "auto=true priority=critical file=/cdrom/install/vortex.cfg" \
    "${@}"
