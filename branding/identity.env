# Vortex OS identity — single source of truth for names and URLs.
# Sourced by package builds, pipelines, and repo scripts.
VORTEX_NAME="Vortex OS"
VORTEX_ID=vortex
VORTEX_CODENAME=cyclone
VORTEX_CODENAME_PRETTY=Cyclone
VORTEX_HOME_URL=https://github.com/khemchan-Seenanan/vortex-os
VORTEX_SUPPORT_URL=https://github.com/khemchan-Seenanan/vortex-os/issues
VORTEX_BUG_URL=https://github.com/khemchan-Seenanan/vortex-os/issues
# Where the signed apt repository is served from (static tree published by repo/publish.sh).
VORTEX_REPO_URL=https://khemchan-seenanan.github.io/vortex-repo
# Debian base release the whole system is built on.
VORTEX_BASE_SUITE=bookworm
